# Copy these into Vercel: Project > Settings > Environment Variables.
# (Never commit real values to GitHub.)

# --- MySQL (required). Must be a host that accepts connections from the internet. ---
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=unsent
DB_USER=unsent_user
DB_PASS=change-me
# Set to 1 if your MySQL host requires a secure (TLS) connection (most cloud hosts do).
DB_SSL=1
# Only needed when PHP cannot find a CA bundle itself (usual on Windows):
# DB_SSL_CA=C:\laragon\etc\ssl\cacert.pem

# --- Debugging a failed deploy (remove both once the site works) ---
# DB_DEBUG=1 shows the exact MySQL error on the page instead of a short hint.
# DB_DEBUG=1
# DIAG_KEY=<some long random secret> unlocks /db-check.php?key=<secret> (read-only connection report).
# DIAG_KEY=

# --- Optional: features stay off when empty ---
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TURN_URL=
TURN_USER=
TURN_PASS=

# --- Optional: only to create the demo account miracle@gmail.com / password123 on an EMPTY database. Leave unset on a real site. ---
# SEED_DEMO=1

# --- Optional: your own push keys. If unset, keys are made once and kept in MySQL. ---
# VAPID_PRIVATE_PEM=-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n
# VAPID_PUBLIC_KEY=
